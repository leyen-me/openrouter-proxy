# Copy to .env and edit. Never commit .env. Used with: docker run --env-file .env ...
#
# TLS is terminated by your own front layer, so keep the default plain-HTTP mode
# and just publish the port:
SITE_ADDRESS=:8080

# Optional: let Caddy terminate TLS itself with an ACME cert instead.
# Point an A record at this server first, then set:
# SITE_ADDRESS=proxy.example.com

# Required. Long random string, e.g. `openssl rand -hex 32`
# Use hex/plain chars only: it is written into the Caddyfile verbatim.
PROXY_SECRET=change-me-to-a-long-random-secret
