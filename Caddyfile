{
	admin off
}

# SITE_ADDRESS:
#   ":8080"              -> plain HTTP on 8080 (use when TLS is terminated in front)
#   "proxy.example.com"  -> automatic HTTPS via Let's Encrypt, listens on 80/443
{$SITE_ADDRESS::8080} {
	@health path /healthz
	respond @health "ok" 200

	reverse_proxy https://openrouter.ai {
		header_up Host openrouter.ai
		# don't forward the client's real IP upstream
		header_up -X-Forwarded-For
		header_up -X-Real-IP
		# stream SSE responses unbuffered (chat completions)
		flush_interval -1
	}
}
